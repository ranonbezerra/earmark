# Copy to core/.env. Only needed for the providers you actually use.

# oMLX only needs a key if you started it with --api-key.
# OMLX_API_KEY=

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Key for a generic OpenAI-compatible endpoint (LM Studio, Groq, ...).
# OUVINTE_COMPATIBLE_API_KEY=

# Where recordings, transcripts and the database live.
# OUVINTE_DATA_DIR=~/Library/Application Support/ouvinte

# OUVINTE_PORT=8756
# OUVINTE_CAPTURE_BIN=/path/to/ouvinte-capture
